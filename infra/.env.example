# =============================================================================
# Radyo Klasik self-hosted radio — environment contract (Phase 0)
# Copy to `.env` in this directory (infra/) and fill in real secrets:
#   cp .env.example .env
# `docker compose` reads infra/.env automatically.
# This is the contract between phases — keep it current.
# =============================================================================

# --- Icecast ----------------------------------------------------------------
# Public hostname Icecast advertises (used in stream URLs / directory).
ICECAST_HOSTNAME=localhost
# SOURCE password: used by Liquidsoap (and later the live harbor) to publish.
ICECAST_SOURCE_PASSWORD=change-me-source
# ADMIN password: Icecast web admin + stats (consumed by Phase 6 analytics).
ICECAST_ADMIN_PASSWORD=change-me-admin
# Where the API/Liquidsoap reach Icecast on the private compose network.
ICECAST_HOST=icecast
ICECAST_PORT=8000

# --- Liquidsoap -------------------------------------------------------------
# Telnet command server. Bound inside the compose network only (not published).
LIQUIDSOAP_HOST=liquidsoap
LIQUIDSOAP_TELNET_PORT=1234

# --- PostgreSQL -------------------------------------------------------------
# Credentials for the postgres container.
POSTGRES_USER=radyo
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=radyoklasik
# DSN the Node API uses. Inside compose the host is the `postgres` service.
# For local (non-docker) dev use: postgres://radyo:...@localhost:5432/radyoklasik
DATABASE_URL=postgres://radyo:change-me-postgres@postgres:5432/radyoklasik
# Set to "true" only if your Postgres requires SSL (managed providers).
DATABASE_SSL=false

# --- Node API auth / secrets ------------------------------------------------
# Express session secret (legacy) + JWT signing secret (new /api/v1 auth).
SECRET_KEY=change-me-session
JWT_SECRET=change-me-jwt
# Shared secret -> JWT exchange used by the existing admin dashboard flow.
SHARED_SECRET_KEY=change-me-shared
# Internal secret for the Liquidsoap <-> API playout endpoints (Phase 2). Used
# by Liquidsoap to call GET /api/v1/playout/next + POST /api/v1/playout/metadata
# (a server-to-server secret, not a user JWT).
INTERNAL_API_SECRET=change-me-internal
# Single bootstrap admin (extended to multi-user roles in Phase 1/7).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-login
# Node listen port.
PORT=8001

# --- Media ------------------------------------------------------------------
# Mount point inside the api/liquidsoap containers for uploaded media (Phase 1).
MEDIA_DIR=/var/media

# --- Playout (Phase 2) ------------------------------------------------------
# Base URL Liquidsoap uses to reach the API on the compose network.
API_BASE=http://api:8001
# Seed a starter AutoDJ rotation from bundled clips on first boot (set "false"
# to disable). Source dir is mounted into the api container.
SEED_ON_START=true
SEED_MEDIA_DIR=/srv/test-media
# Crossfade duration (seconds) between AutoDJ tracks.
CROSSFADE_DURATION=3.0
# Insert a jingle every N songs in the AutoDJ rotation (consumed by the API's
# /api/v1/playout/next selection).
AUTODJ_JINGLE_EVERY=4

# --- Queue & autopilot (Phase 3) --------------------------------------------
# Liquidsoap source ids the API drives over telnet: the request queue spliced
# ahead of AutoDJ, and the icecast output (for `*.skip`). Must match radio.liq.
LIQUIDSOAP_QUEUE_ID=requests
LIQUIDSOAP_OUTPUT_ID=radio_out
# Initial autopilot (AutoDJ rotation) state on boot. Set "false" to start with
# rotation off (only queued/live content plays; failover holds dead air).
AUTOPILOT_DEFAULT=true

# --- Live DJ / Virtual Studio (Phase 4) -------------------------------------
# Liquidsoap input.harbor for the live mic. The browser mic is bridged
# (browser -> WS Opus -> Node ffmpeg -> icecast SOURCE -> harbor "/live") and
# mixed into /stream. The harbor port lives on the private radyonet only (NOT
# published to the host). Use a dedicated SOURCE password for the live mount.
LIVE_HARBOR_PORT=8005
LIVE_HARBOR_USER=source
LIVE_HARBOR_PASSWORD=change-me-live-source
LIVE_HARBOR_MOUNT=live
# Seconds the harbor tolerates silence/stalls before declaring the source dead.
LIVE_HARBOR_TIMEOUT=10.0
# Auto-failback window (ms): after the studio disconnects, the API tears the
# session down to idle if audio does not return within this window. Liquidsoap
# restores the music bed instantly on disconnect regardless (no dead air).
LIVE_FALLBACK_TIMEOUT_MS=8000
# Default voice-over duck level (portion of music kept under the mic) and the
# mic silence threshold (linear RMS) — per-DJ values override these at connect.
LIVE_DUCK_LEVEL=0.25
LIVE_SILENCE_THRESHOLD=0.05
# Fade duration (s) for the live mic over the music in the smooth_add mix.
LIVE_FADE_DURATION=0.8

# --- Caddy / domains --------------------------------------------------------
# On the VPS set these to the real hostnames for automatic HTTPS.
STREAM_DOMAIN=stream.radyoklasik.online
API_DOMAIN=api.radyoklasik.online
CADDY_EMAIL=admin@radyoklasik.online

# --- MinIO (optional, S3-compatible media storage; `--profile minio`) -------
MINIO_ROOT_USER=radyo
MINIO_ROOT_PASSWORD=change-me-minio
