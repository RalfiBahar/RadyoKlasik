# Radyo Klasik reverse proxy + automatic HTTPS (Phase 0 scaffolding).
#
# On the VPS, set STREAM_DOMAIN / API_DOMAIN to the real hostnames and Caddy
# will provision Let's Encrypt certificates automatically. Locally you can
# leave the defaults (Caddy will fail to obtain public certs for those names,
# which is fine — the Phase 0 smoke test hits Icecast :8000 and the API :8001
# directly, bypassing Caddy).

{
	email {$CADDY_EMAIL:admin@radyoklasik.online}
}

# Icecast stream distribution. The JSON access log is the source of listener
# sessions (real client IP, user agent, duration, bytes) for Phase 6 analytics,
# because Icecast 2.4 only ever sees Caddy's address. Behind a CDN/proxy such
# as Cloudflare, add `trusted_proxies` in the global options so client_ip is
# the listener rather than the CDN edge.
(stream_site) {
	log {
		output file /var/log/caddy/stream-access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
	# Phase 9: HLS (adaptive AAC) written by Liquidsoap.
	handle_path /hls/* {
		root * /srv/hls
		header Access-Control-Allow-Origin *
		@playlist path *.m3u8
		header @playlist Cache-Control "no-cache"
		@segment path *.ts
		header @segment Cache-Control "public, max-age=60"
		file_server
	}
	reverse_proxy icecast:8000
}

{$STREAM_DOMAIN:stream.radyoklasik.online} {
	import stream_site
}

# Local testing of the proxied stream path without TLS:
#   curl -H "Host: stream.localhost" http://localhost/stream
http://stream.localhost {
	import stream_site
}

# Everything admin lives on the API domain:
#   /            -> redirect to the panel
#   /panel/...   -> DJ / admin panel (the `studio` container, Next basePath)
#   everything else -> the Node API, incl. the legacy EJS admin dashboard
#                      (/auth/login, /dashboard, /chat, ...) and the listener
#                      routes used by the website and mobile app.
(api_site) {
	encode gzip
	header /panel* {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The studio needs the microphone; nothing else may use it.
		Permissions-Policy "microphone=(self), camera=()"
	}
	# /metrics is for the internal scraper only.
	handle /metrics {
		respond 404
	}
	handle /panel* {
		reverse_proxy studio:3001
	}
	handle {
		redir / /panel 302
		reverse_proxy api:8001
	}
}

{$API_DOMAIN:api.radyoklasik.online} {
	header Strict-Transport-Security "max-age=31536000"
	import api_site
}

# Local test of the single-domain setup without TLS: http://api.localhost/
http://api.localhost {
	import api_site
}
