# radyo-klasik-studio — DJ host dashboard / Virtual Studio (Phase 5)
# Copy to .env.local for local dev:  cp .env.example .env.local

# --- Build/server-side -----------------------------------------------------
# Control-plane API base, proxied by Next rewrites (REST + auth + media).
# Dev: the dockerized API published on :8001. Prod: https://api.radyoklasik.online
STUDIO_API_URL=http://localhost:8001

# --- Public (exposed to the browser) ---------------------------------------
# WebSocket base for the studio channels (/ws/studio, /ws/ingest). WS upgrades
# are NOT proxied through Next rewrites, so the browser connects directly.
# Dev: ws://localhost:8001 . Prod: wss://api.radyoklasik.online
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Shown on the login screen / used as a default. The shared secret itself is
# entered at login (never baked in); dev value is "dev-shared".
NEXT_PUBLIC_STATION_NAME=Radyo Klasik Online

# Public listener stream URL (shown on the Dashboard "broadcast link" card).
NEXT_PUBLIC_STREAM_URL=http://localhost:8000/stream

# Broadcast link settings surfaced read-only on the Dashboard (the SOURCE
# connection an external encoder would use against the Liquidsoap /live harbor).
# Password is intentionally NOT exposed to the browser.
NEXT_PUBLIC_BROADCAST_HOST=stream.radyoklasik.online
NEXT_PUBLIC_BROADCAST_PORT=8005
NEXT_PUBLIC_BROADCAST_MOUNT=/live
NEXT_PUBLIC_BROADCAST_USER=source
NEXT_PUBLIC_BROADCAST_ENCODING=MP3 128k
